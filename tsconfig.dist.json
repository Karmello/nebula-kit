{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "target": "es2020",
    "module": "nodenext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "lib": ["ES2021.String"],
    "paths": {
      "client/*": ["src/client/*"],
      "lib/*": ["src/lib/*"],
    }
  },
  "include": ["src/lib/index.ts", "src/lib/extensions.d.ts"]
}
