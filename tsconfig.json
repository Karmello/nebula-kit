{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "lib": ["ES2021.String", "ES2024"],
    "paths": {
      "client/*": ["src/client/*"],
      "lib/*": ["src/lib/*"]
    }
  },
  "include": ["src/**/*"]
}
