{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "esModuleInterop": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "client/*": ["src/client/*"],
      "lib/*": ["src/lib/*"]
    }
  },
  "include": ["src/**/*"]
}
