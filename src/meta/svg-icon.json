{
  "name": "SvgIcon",
  "description": "",
  "props": [
    {
      "name": "name",
      "type": "IconName",
      "options": [
        "check",
        "close",
        "search",
        "menu",
        "panel-left-open",
        "panel-right-open",
        "chevron-down",
        "chevron-up",
        "chevron-left",
        "chevron-right"
      ],
      "required": true,
      "defaultValue": "",
      "description": ""
    },
    {
      "name": "size",
      "type": "ScaleValue",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "",
      "description": ""
    },
    {
      "name": "intent",
      "type": "BoxIntent",
      "options": [
        "neutral",
        "primary",
        "secondary",
        "tertiary",
        "success",
        "info",
        "warning",
        "danger",
        "inverse"
      ],
      "required": false,
      "defaultValue": "'neutral'",
      "description": ""
    }
  ]
}