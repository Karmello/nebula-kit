{
  "name": "Box",
  "description": "Box is the foundational layout primitive. It renders as any element (div by default) and provides consistent spacing, typography, sizing, and surface styling through responsive props and CSS variables. Use it as the base container or building block for more complex components.",
  "props": [
    {
      "name": "variant",
      "type": "BoxVariant",
      "options": [
        "solid",
        "outline",
        "ghost"
      ],
      "required": false,
      "defaultValue": "'ghost'",
      "description": "Visual style of the box surface (e.g. solid, outline)"
    },
    {
      "name": "intent",
      "type": "BoxIntent",
      "options": [
        "neutral",
        "primary",
        "secondary",
        "tertiary",
        "success",
        "info",
        "warning",
        "danger",
        "inverse"
      ],
      "required": false,
      "defaultValue": "'neutral'",
      "description": "Semantic tone or purpose (e.g. neutral, success, danger)"
    },
    {
      "name": "textIntent",
      "type": "BoxIntent",
      "options": [
        "neutral",
        "primary",
        "secondary",
        "tertiary",
        "success",
        "info",
        "warning",
        "danger",
        "inverse"
      ],
      "required": false,
      "defaultValue": "",
      "description": ""
    },
    {
      "name": "interactive",
      "type": "boolean",
      "options": [],
      "required": false,
      "defaultValue": "false",
      "description": "Marks the box as interactive, enabling hover/focus styles"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "options": [],
      "required": false,
      "defaultValue": "false",
      "description": "Disables interaction and applies a muted style"
    },
    {
      "name": "display",
      "type": "ResponsiveProp<CssDisplay>",
      "options": [
        "block",
        "inline",
        "inline-block",
        "table",
        "table-header-group",
        "table-row-group",
        "table-footer-group",
        "table-row",
        "table-cell",
        "revert",
        "initial",
        "none"
      ],
      "required": false,
      "defaultValue": "",
      "description": "Sets font size using scale values or raw CSS values"
    },
    {
      "name": "overflowX",
      "type": "ResponsiveProp<CssOverflow>",
      "options": [
        "visible",
        "auto",
        "hidden",
        "scroll"
