{
  "name": "Box",
  "description": "Box is the foundational layout primitive. It renders as any element (div by default) and provides consistent spacing, typography, sizing, and surface styling through responsive props and CSS variables. Use it as the base container or building block for more complex components.",
  "props": [
    {
      "name": "variant",
      "type": "BoxVariant",
      "options": [
        "solid",
        "outline",
        "ghost"
      ],
      "required": false,
      "defaultValue": "'solid'",
      "description": "Visual style of the box surface (e.g. solid, outline)"
    },
    {
      "name": "intent",
      "type": "BoxIntent",
      "options": [
        "neutral",
        "primary",
        "secondary",
        "tertiary",
        "success",
        "info",
        "warning",
        "danger",
        "inverse"
      ],
      "required": false,
      "defaultValue": "'neutral'",
      "description": "Semantic tone or purpose (e.g. neutral, success, danger)"
    },
    {
      "name": "interactive",
      "type": "boolean",
      "options": [],
      "required": false,
      "defaultValue": "false",
      "description": "Marks the box as interactive, enabling hover/focus styles"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "options": [],
      "required": false,
      "defaultValue": "false",
      "description": "Disables interaction and applies a muted style"
    },
    {
      "name": "fontSize",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "'inherit'",
      "description": "Sets font size using scale values or raw CSS values"
    },
    {
      "name": "lineHeight",
      "type": "ResponsiveProp<number | string>",
      "options": [],
      "required": false,
      "defaultValue": "'normal'",
      "description": "Controls line height for text content"
    },
    {
      "name": "textAlign",
      "type": "ResponsiveProp<TextAlign>",
      "options": [
        "left",
        "right",
        "center",
        "justify",
        "start",
        "end",
        "inherit",
        "initial",
        "unset",
        "revert"
      ],
      "required": false,
      "defaultValue": "'initial'",
      "description": "Horizontal alignment of text (start, center, end, etc.)"
    },
    {
      "name": "height",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "'auto'",
      "description": "Explicit height of the box"
    },
    {
      "name": "minHeight",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "'auto'",
      "description": "Minimum height constraint"
    },
    {
      "name": "maxHeight",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "'none'",
      "description": "Maximum height constraint"
    },
    {
      "name": "pt",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Padding top"
    },
    {
      "name": "pr",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Padding right"
    },
    {
      "name": "pb",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Padding bottom"
    },
    {
      "name": "pl",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Padding left"
    },
    {
      "name": "px",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Horizontal padding (left & right)"
    },
    {
      "name": "py",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Vertical padding (top & bottom)"
    },
    {
      "name": "p",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Padding on all sides"
    },
    {
      "name": "mt",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Margin top"
    },
    {
      "name": "mr",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Margin right"
    },
    {
      "name": "mb",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Margin bottom"
    },
    {
      "name": "ml",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Margin left"
    },
    {
      "name": "mx",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Horizontal margin (left & right)"
    },
    {
      "name": "my",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Vertical margin (top & bottom)"
    },
    {
      "name": "m",
      "type": "ResponsiveProp<ScaleValue | string>",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "0",
      "description": "Margin on all sides"
    }
  ]
}