{
  "name": "Button",
  "description": "Button is a polymorphic action component built on Box. It supports variants, intents, and sizes, with optional icons on either side. Padding and height adjust automatically per size.",
  "props": [
    {
      "name": "variant",
      "type": "BoxOwnProps['variant']",
      "options": [
        "solid",
        "outline",
        "ghost"
      ],
      "required": false,
      "defaultValue": "'solid'",
      "description": "Visual style variant of the button (e.g. solid, outline, ghost)"
    },
    {
      "name": "intent",
      "type": "BoxOwnProps['intent']",
      "options": [
        "neutral",
        "primary",
        "secondary",
        "tertiary",
        "success",
        "info",
        "warning",
        "danger",
        "inverse"
      ],
      "required": false,
      "defaultValue": "'tertiary'",
      "description": "Semantic intent for coloring (e.g. primary, success, danger, neutral)"
    },
    {
      "name": "textIntent",
      "type": "BoxOwnProps['textIntent']",
      "options": [
        "neutral",
        "primary",
        "secondary",
        "tertiary",
        "success",
        "info",
        "warning",
        "danger",
        "inverse"
      ],
      "required": false,
      "defaultValue": "",
      "description": ""
    },
    {
      "name": "disabled",
      "type": "BoxOwnProps['disabled']",
      "options": [],
      "required": false,
      "defaultValue": "false",
      "description": "Disables interaction and applies disabled styling"
    },
    {
      "name": "borderRadius",
      "type": "BoxOwnProps['borderRadius']",
      "options": "0, 1, 2 ... 80",
      "required": false,
      "defaultValue": "",
      "description": ""
    },
    {
      "name": "size",
      "type": "ButtonSize",
      "options": [
        "sm",
        "md",
        "lg"
      ],
      "required": false,
      "defaultValue": "'md'",
      "description": "Button size controlling height, padding, and font size"
    },
    {
      "name": "iconName",
      "type": "WithIconOwnProps['iconName']",
      "options": [
        "check",
        "close",
        "search",
        "menu",
        "panel-left-open",
        "panel-right-open",
        "chevron-down",
        "chevron-up",
        "chevron-left",
        "chevron-right"
      ],
      "required": false,
      "defaultValue": "",
      "description": "Optional icon name to render inside the button"
    },
    {
      "name": "iconPosition",
      "type": "WithIconOwnProps['iconPosition']",
      "options": [
        "left",
        "right"
      ],
      "required": false,
      "defaultValue": "",
      "description": "Position of the icon relative to text (e.g. left or right)"
    }
  ]
}