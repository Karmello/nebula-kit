FROM node:20-alpine AS builder
WORKDIR /app

ARG PAT
ENV PAT=$PAT

ARG API_URL
ENV API_URL=$API_URL

RUN corepack enable && corepack use yarn@4.10.3

# copy package files first
COPY package.json yarn.lock .yarnrc.yml ./

# copy workspace manifests
COPY tools/package.json ./tools/package.json

# install dependencies (classic node_modules linker)
RUN yarn install --immutable

# now bring in the rest of your source
COPY . .

ENV NODE_ENV=production

# run build with node_modules intact
RUN yarn build


FROM node:20-alpine AS runner
WORKDIR /app

RUN corepack enable && corepack use yarn@4.10.3

# copy only the production subset
COPY package.json yarn.lock .yarnrc.yml ./
COPY tools/package.json ./tools/package.json

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/build ./build
COPY --from=builder /app/index.html ./index.html

ENV NODE_ENV=production
ENV NODE_OPTIONS=--enable-source-maps

CMD ["yarn", "start"]