{
  "name": "@nebula-kit/core",
  "description": "Web UI library",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "url": "git+https://github.com/Karmello/ui-bb.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "22.18.0"
  },
  "scripts": {
    "dev-server": "nodemon -L --config nodemon.server.json",
    "dev-client": "nodemon -L --config nodemon.client.json",
    "start-dev": "yarn dev-server & yarn dev-client",
    "start": "NODE_ENV=production node build/server.js",
    "start-local-prod": "SERVER_PORT=10200 NODE_ENV=production LOCAL_ENV=true node build/server.js",
    "build-server": "webpack --config webpack/webpack.server.config",
    "build-client": "rimraf build/client && NODE_ENV=production webpack --config webpack/webpack.client.config",
    "build": "yarn build-server && yarn build-client",
    "clean": "rimraf build",
    "prettier": "prettier --check src/**/*.{ts,tsx}",
    "prettify": "prettier --write src/**/*.{ts,tsx}",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit -p tsconfig.webpack.json",
    "tsd": "tsc -p tsconfig.types.json && tsd -t dist/types/index.d.ts -f src/lib/components/**/*.test.d.tsx",
    "jest": "NODE_ENV=test NODE_NO_WARNINGS=1 jest --watch --verbose --detectOpenHandles",
    "jest-ci": "NODE_ENV=test jest --silent --detectOpenHandles",
    "jest-cov": "NODE_ENV=test jest --watchAll --coverage -u",
    "pw": "playwright test -c playwright.config.ts",
    "dist": "./scripts/distribute.sh",
    "lib": "git push && yarn dist && npm publish",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "body-parser": "^2.2.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "date-fns": "^3.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "history": "^5.3.0",
    "i18next": "^25.0.1",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.539.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.8.2",
    "react-toastify": "^9.1.3",
    "shiki": "^3.12.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^8.30.1",
    "babel-loader": "^10.0.0",
    "brotli-webpack-plugin": "^1.1.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "ignore-loader": "^0.1.2",
    "ignore-styles": "^5.0.1",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "less": "^4.3.0",
    "less-loader": "^12.2.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsd": "^0.33.0",
    "typescript": "^5.8.3",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
