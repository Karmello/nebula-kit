{
  "name": "@nebula-kit/core",
  "description": "NebulaKit is a UI library created with React, TypeScript, and CSS for building web applications.",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "url": "git+https://github.com/Karmello/ui-bb.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon -L --exec \"vite --config vite.client.dev.ts\" --watch vite.client.dev.ts --verbose",
    "dev:ssr": "nodemon -L --exec \"tsx src/server/server.dev.ts\" --watch src/server/server.dev.ts --verbose",
    "clean": "rimraf build",
    "prettier": "prettier --check src/**/*.{ts,tsx}",
    "prettify": "prettier --write src/**/*.{ts,tsx}",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "tsd": "tsc -p tsconfig.types.json && tsd -t dist/types/index.d.ts -f src/lib/components/**/*.test.d.tsx",
    "test": "vitest run",
    "pw": "playwright test -c playwright.config.ts",
    "dist": "./scripts/distribute.sh",
    "lib": "git push && yarn dist && npm publish",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@shikijs/core": "^3.12.0",
    "@shikijs/engine-javascript": "^3.12.0",
    "@shikijs/langs": "^3.12.0",
    "@shikijs/themes": "^3.12.0",
    "body-parser": "^2.2.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "date-fns": "^3.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "history": "^5.3.0",
    "i18next": "^25.0.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.539.0",
    "react-hook-form": "^7.56.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.9.1",
    "react-toastify": "^9.1.3",
    "shiki": "^3.12.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "babel-loader": "^10.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "ignore-loader": "^0.1.2",
    "ignore-styles": "^5.0.1",
    "jsdom": "^26.1.0",
    "less": "^4.3.0",
    "less-loader": "^12.2.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-element-to-jsx-string": "^17.0.1",
    "sass": "^1.92.1",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsd": "^0.33.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
