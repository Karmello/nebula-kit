{
  "name": "@nebula-kit/core",
  "version": "0.4.2",
  "description": "React UI system built on composition and prop inheritance, with strict rules governing component appearance and behavior. Designed to reduce UI entropy and keep interfaces consistent and maintainable as products grow over time.",
  "homepage": "https://nebulakit.dev",
  "funding": {
    "type": "url",
    "url": "https://nebulakit.dev/pricing"
  },
  "bugs": {
    "url": "https://discord.com/invite/BgezCRDN8H"
  },
  "keywords": [
    "nebulakit",
    "react",
    "ui",
    "library",
    "reusable",
    "components",
    "design",
    "system",
    "accessibility",
    "typescript",
    "jsx",
    "composition",
    "semantics",
    "responsive",
    "ssr"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "style": "./styles.css",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "dev": "nodemon -L --exec \"vite --config vite.client.dev.ts\" --watch vite.client.dev.ts --verbose",
    "dev:ssr": "nodemon -L --exec \"tsx src/server/server.dev.ts\" --watch src/server/server.dev.ts --verbose",
    "build:client": "NODE_ENV=production vite build --config vite.client.prod.ts && node ./scripts/generate-sitemap.js",
    "build:server": "NODE_ENV=production tsup --config tsup.server.ts",
    "build": "rimraf build && yarn build:client && yarn build:server",
    "start": "NODE_ENV=production node build/server/server.prod.js",
    "prettier": "prettier --check src/**/*.{ts,tsx}",
    "prettify": "prettier --write src/**/*.{ts,tsx}",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "tsd": "rimraf dist && tsc -p tsconfig.tsd.json && tsd --cwd . -t dist/types/index.d.ts -f \"src/lib/components/**/*.test.d.tsx\"",
    "test": "vitest run",
    "pw": "playwright test -c playwright.config.cjs",
    "prepare": "husky install",
    "dump:meta": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--loader ./scripts/ignore-assets-loader.js' tsx ./scripts/dump-meta.js",
    "dist:css": "sass --load-path src/lib src/lib/styles/index.$TSUP_BUNDLE.scss dist/$TSUP_BUNDLE/styles.css --no-source-map",
    "dist:bundle": "yarn dump:meta && tsup --config tsup.pkg.ts && yarn dist:css && node ./scripts/annotate-props-jsdoc.js && node ./scripts/annotate-components-jsdoc.js && node ./scripts/generate-package-json.js && node ./scripts/generate-readme.js",
    "dist:core": "rimraf dist/core && TSUP_BUNDLE=core yarn dist:bundle && TSUP_BUNDLE=core yarn dist:clean",
    "dist:pro": "rimraf dist/pro && TSUP_BUNDLE=pro yarn dist:bundle && TSUP_BUNDLE=pro yarn dist:clean",
    "dist:clean": "rimraf dist/$TSUP_BUNDLE/index.d.cts && rimraf dist/$TSUP_BUNDLE/meta.js",
    "pack:pro": "npm pack ./dist/pro --pack-destination ./dist && mv dist/*private-pro-*.tgz dist/nebula-kit-pro-$(node -p \"require('./package.json').version\").tgz",
    "upload:pro:dev": "node ./scripts/update-local-versioning-json.js && aws s3 cp ./versioning.json s3://nebula-kit-pro-dev && aws s3 cp dist/nebula-kit-pro-$(node -p \"require('./package.json').version\").tgz s3://nebula-kit-pro-dev/nebula-kit-pro-$(node -p \"require('./package.json').version\").tgz",
    "upload:pro": "node ./scripts/update-local-versioning-json.js && aws s3 cp ./versioning.json s3://nebula-kit-pro && aws s3 cp dist/nebula-kit-pro-$(node -p \"require('./package.json').version\").tgz s3://nebula-kit-pro/nebula-kit-pro-$(node -p \"require('./package.json').version\").tgz",
    "publish:core": "yarn dist:core && npm publish ./dist/core --access public",
    "publish:pro": "yarn dist:pro && yarn pack:pro && yarn upload:pro",
    "publish:gh": "yarn dist && npm publish ./dist/core --registry=https://npm.pkg.github.com && npm publish ./dist/pro --registry=https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@shikijs/core": "^3.12.0",
    "@shikijs/engine-javascript": "^3.12.0",
    "@shikijs/langs": "^3.12.0",
    "@shikijs/themes": "^3.12.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "express": "^5.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "react-element-to-jsx-string": "^17.0.1",
    "react-hook-form": "7.66.0",
    "react-is": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "shiki": "^3.12.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@hiogawa/vite-plugin-error-overlay": "^0.0.1",
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tinycolor2": "^1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "get-port": "^7.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "sass": "^1.92.1",
    "tinycolor2": "^1.6.0",
    "ts-morph": "^27.0.2",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
