{
  "name": "@nebula-kit/core",
  "description": "NebulaKit is a UI library created with React, TypeScript, and CSS for building web applications.",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "url": "git+https://github.com/Karmello/ui-bb.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon -L --exec \"vite --config vite.client.dev.ts\" --watch vite.client.dev.ts --verbose",
    "dev:ssr": "nodemon -L --exec \"tsx src/server/server.dev.ts\" --watch src/server/server.dev.ts --verbose",
    "build:client": "NODE_ENV=production vite build --config vite.client.prod.ts",
    "build:server": "NODE_ENV=production tsup --config tsup.server.ts",
    "build": "yarn build:client && yarn build:server",
    "run:prod": "NODE_ENV=production node dist/server/server.prod.mjs",
    "clean": "rimraf build",
    "prettier": "prettier --check src/**/*.{ts,tsx}",
    "prettify": "prettier --write src/**/*.{ts,tsx}",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "tsd": "tsc -p tsconfig.types.json && tsd -t dist/types/index.d.ts -f src/lib/components/**/*.test.d.tsx",
    "test": "vitest run",
    "pw": "playwright test -c playwright.config.ts",
    "dist": "./scripts/distribute.sh",
    "lib": "git push && yarn dist && npm publish",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@shikijs/core": "^3.12.0",
    "@shikijs/engine-javascript": "^3.12.0",
    "@shikijs/langs": "^3.12.0",
    "@shikijs/themes": "^3.12.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "express": "^5.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.539.0",
    "react-element-to-jsx-string": "^17.0.1",
    "react-router-dom": "^7.9.1",
    "shiki": "^3.12.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "get-port": "^7.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.92.1",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
