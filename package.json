{
  "name": "@nebula-kit/core",
  "version": "0.11.0",
  "description": "React UI system built on composition and prop inheritance, with strict rules governing component appearance and behavior. Designed to reduce UI entropy and keep interfaces consistent and maintainable as products grow over time.",
  "homepage": "https://nebulakit.dev",
  "funding": {
    "type": "url",
    "url": "https://nebulakit.dev/pricing"
  },
  "bugs": {
    "url": "https://discord.com/invite/BgezCRDN8H"
  },
  "keywords": [
    "nebulakit",
    "react",
    "ui",
    "library",
    "reusable",
    "components",
    "design",
    "system",
    "accessibility",
    "typescript",
    "jsx",
    "composition",
    "semantics",
    "responsive",
    "ssr"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "style": "./styles.css",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "dev": "nodemon -L --exec \"vite --config vite.client.dev.ts\" --watch vite.client.dev.ts --verbose",
    "dev:ssr": "nodemon -L --exec \"tsx src/server/server.dev.ts\" --watch src/server/server.dev.ts --verbose",
    "build:client": "NODE_ENV=production vite build --config vite.client.prod.ts && node ./tools/common/generate-sitemap.js",
    "build:server": "NODE_ENV=production tsup --config tsup.server.ts",
    "build": "rimraf build && yarn build:client && yarn build:server",
    "start": "NODE_ENV=production node build/server/server.prod.js",
    "prettier": "prettier --check src/**/*.{ts,tsx}",
    "prettify": "prettier --write src/**/*.{ts,tsx}",
    "lint": "eslint src/**/*.{ts,tsx}",
    "circ": "madge --circular --extensions ts,tsx src",
    "ts": "tsc --noEmit -p tsconfig.typecheck.json",
    "tsd": "rimraf dist && tsc -p tsconfig.tsd.json && tsd --cwd . -t dist/types/index.d.ts -f \"src/lib/components/**/*.test.d.tsx\"",
    "test": "vitest run",
    "pw": "playwright test -c playwright.config.cjs",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@shikijs/core": "^3.12.0",
    "@shikijs/engine-javascript": "^3.12.0",
    "@shikijs/langs": "^3.12.0",
    "@shikijs/themes": "^3.12.0",
    "change-case": "^5.4.4",
    "classnames": "^2.5.1",
    "express": "^5.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "motion": "^12.40.0",
    "react-element-to-jsx-string": "^17.0.1",
    "react-hook-form": "7.66.0",
    "react-is": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.12.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@hiogawa/vite-plugin-error-overlay": "^0.0.1",
    "@playwright/experimental-ct-react": "^1.55.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "get-port": "^7.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "madge": "^8.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "ts-morph": "^27.0.2",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
