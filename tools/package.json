{
  "name": "@nebula-kit/tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "assistant:generate:foundations": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--loader ./common/ignore-assets-loader.js' tsx ./assistant/generate-foundations/index.tsx",
    "assistant:generate:docs": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--loader ./common/ignore-assets-loader.js' tsx ./assistant/generate-component-docs/index.ts",
    "assistant:generate:releases": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--loader ./common/ignore-assets-loader.js' tsx ./assistant/generate-releases/index.ts",
    "assistant:generate:faq": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--loader ./common/ignore-assets-loader.js' tsx ./assistant/generate-faq/index.ts",
    "assistant:generate:marketing": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--loader ./common/ignore-assets-loader.js' tsx ./assistant/generate-marketing-data/index.ts",
    "assistant:generate": "rimraf ../assistant && yarn assistant:generate:foundations && yarn assistant:generate:docs && yarn assistant:generate:releases && yarn assistant:generate:faq && yarn assistant:generate:marketing"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0"
  }
}
